# Server Configuration
PORT=5001
JWT_SECRET=your_jwt_secret_key_here

# AI & LLM Engines
GROQ_API_KEY=your_groq_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Apify Web Automation & Scraping
APIFY_USER_ID=your_apify_user_id
APIFY_API_KEY=your_apify_api_key

# Supabase & PostgreSQL Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_DB_PASSWORD=your_database_password
DATABASE_URL=postgresql://postgres.your-ref:password@aws-0-pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres:password@db.your-ref.supabase.co:5432/postgres

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Dispatcher (Nodemailer / Gmail SMTP)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
GMAIL_SECONDARY_USER=your_secondary_email@gmail.com
GMAIL_SECONDARY_APP_PASSWORD=your_secondary_app_password

# WhatsApp Cloud API Notifications
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_TOKEN=your_whatsapp_bearer_token
ADMIN_WHATSAPP_NUMBER=923000000000
